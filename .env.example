# ============================================
# Alpaca Trading Bot - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# Alpaca API Keys (REQUIRED)
# ============================================
# Get your API keys from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# ============================================
# Alpaca API Configuration
# ============================================
# Paper Trading Mode (true = paper trading, false = live trading)
ALPACA_PAPER=true

# Alpaca API Base URLs (OPTIONAL - defaults shown below)
# These are automatically set based on ALPACA_PAPER, but you can override them
# Paper Trading URL (default when ALPACA_PAPER=true):
ALPACA_PAPER_API_URL=https://paper-api.alpaca.markets/v2
# Live Trading URL (default when ALPACA_PAPER=false):
ALPACA_LIVE_API_URL=https://api.alpaca.markets
# Data API URL (used for market data, same for paper and live):
ALPACA_DATA_API_URL=https://data.alpaca.markets/v2

# Custom Trading API URL (OPTIONAL - overrides above defaults)
# Leave empty to use defaults based on ALPACA_PAPER setting
# Example: ALPACA_TRADING_API_URL=https://paper-api.alpaca.markets/v2
ALPACA_TRADING_API_URL=

# Custom Data API URL (OPTIONAL - overrides above defaults)
# Leave empty to use default data API URL
# Example: ALPACA_DATA_API_URL=https://data.alpaca.markets/v2
# Note: This is already set above, but you can override it here
# ALPACA_DATA_API_URL=

# ============================================
# Server Ports
# ============================================
# API Server Port (Flask backend)
PORT_API=8080

# UI Server Port (Next.js frontend)
PORT_UI=3000

# Next.js Public API Port (for frontend to connect to backend)
# This must be prefixed with NEXT_PUBLIC_ to be accessible in the browser
# Must match PORT_API
NEXT_PUBLIC_API_PORT=8080

# Next.js Public API Host (for frontend to connect to backend)
# For local development: leave empty or use "localhost"
# For Cloudflare Pages deployment: set to your backend domain (e.g., "api-your-domain.com")
# This must be prefixed with NEXT_PUBLIC_ to be accessible in the browser
NEXT_PUBLIC_API_HOST=

# ============================================
# Notification Settings (OPTIONAL)
# ============================================

# Discord Webhook URL (optional)
# Get webhook URL from Discord channel settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=

# Email Notifications (optional)
# Set EMAIL_NOTIFICATIONS_ENABLED=true to enable email notifications
EMAIL_NOTIFICATIONS_ENABLED=false

# SMTP Configuration (for Gmail, use App Password - see README)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD="your-16-character-app-password"

# Email Recipients (comma-separated for multiple recipients)
# Example: EMAIL_TO=recipient1@example.com,recipient2@example.com
EMAIL_TO=recipient@example.com

# ============================================
# Application Settings
# ============================================

# Use test CSV by default (fewer symbols, less API calls)
# Set to false to use production CSV files
USE_TEST_CSV=true

# Polling interval in seconds (fallback mode when WebSocket unavailable)
POLL_INTERVAL_SECONDS=60

# ============================================
# Cloudflare Deployment (OPTIONAL)
# ============================================
# Cloudflare API Token for wrangler CLI and deployment management
# Get token from: https://dash.cloudflare.com/profile/api-tokens
# Use "Edit Cloudflare Workers" template or create custom token with:
#   - Account → Cloudflare Pages → Edit
#   - User → User Details → Read
# CLOUDFLARE_API_TOKEN=

# Cloudflare Account ID (optional, can be found in dashboard URL)
# Format: 32-character hex string (e.g., 0e94c4d1c494e783d4d386498de3652d)
# CLOUDFLARE_ACCOUNT_ID=

