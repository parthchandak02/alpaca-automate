# ============================================
# Alpaca Order Manager - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# REQUIRED CONFIGURATION
# ============================================

# --- Alpaca API Keys (REQUIRED) ---
# Get your API keys from: https://app.alpaca.markets/paper/dashboard/overview
# For paper trading: https://app.alpaca.markets/paper/dashboard/overview
# For live trading: https://app.alpaca.markets/dashboard/overview
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# --- Trading Mode (REQUIRED) ---
# Set to true for paper trading (recommended for testing)
# Set to false for live trading (real money - use with caution!)
ALPACA_PAPER=true

# --- Authentication (REQUIRED - Choose ONE method) ---
# Option 1: Plain text password (simpler, less secure)
UI_PASSWORD=your_secure_password_here

# Option 2: Bcrypt hash (more secure, recommended for production)
# Generate with: python scripts/setup_auth.py
# APP_PASSWORD_HASH=$2b$12$...
# JWT_SECRET_KEY=your_random_secret_key_here

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# --- Server Ports (Optional - defaults shown) ---
PORT_API=8080
PORT_UI=3000

# --- Frontend API Configuration (Optional - for production) ---
# These are only needed for Cloudflare Pages deployment
# For local development, frontend auto-detects localhost
NEXT_PUBLIC_API_HOST=api-your-domain.com
NEXT_PUBLIC_API_PORT=443

# --- Email Notifications (OPTIONAL) ---
# Set to true to enable email notifications for order status changes
EMAIL_NOTIFICATIONS_ENABLED=false

# SMTP Configuration (for Gmail, use App Password - see README)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# Email Recipients (comma-separated for multiple recipients)
EMAIL_TO=recipient@example.com

# --- Discord Notifications (OPTIONAL) ---
# Get webhook URL from Discord channel settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# --- CSV Files (OPTIONAL) ---
# Set to true to use test CSV files (fewer symbols, less API calls)
# Set to false to use production CSV files
USE_TEST_CSV=true

# --- Polling Settings (OPTIONAL) ---
# Polling interval in seconds (fallback mode when WebSocket unavailable)
POLL_INTERVAL_SECONDS=60

# ============================================
# ADVANCED CONFIGURATION (Usually Don't Change)
# ============================================

# --- Alpaca API URLs (OPTIONAL - Auto-set based on ALPACA_PAPER) ---
# These are automatically set based on ALPACA_PAPER, but you can override them
# ALPACA_PAPER_API_URL=https://paper-api.alpaca.markets/v2
# ALPACA_LIVE_API_URL=https://api.alpaca.markets
# ALPACA_DATA_API_URL=https://data.alpaca.markets/v2
# ALPACA_TRADING_API_URL=

# --- Cloudflare Deployment (OPTIONAL - For Production) ---
# Only needed if using Cloudflare Pages/Wrangler CLI
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# ============================================
# NOTES
# ============================================
# 1. Never commit .env file to version control (it's gitignored)
# 2. For authentication, use scripts/setup_auth.py to generate secure hash
# 3. For Gmail SMTP, use App Password (not regular password)
# 4. Test in paper trading mode (ALPACA_PAPER=true) first!
# 5. See README.md for detailed setup instructions
