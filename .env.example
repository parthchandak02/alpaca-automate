# ============================================
# ALPACA TRADING CONFIGURATION
# ============================================

# Trading Mode Flag
# Set to true for paper trading (simulated), false for live trading (real money)
# Change this ONE flag to switch between paper and live trading
USE_PAPER_TRADING=true

# ============================================
# PAPER TRADING CREDENTIALS
# ============================================
ALPACA_PAPER_API_KEY=your_paper_api_key_here
ALPACA_PAPER_SECRET_KEY=your_paper_secret_key_here
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# ============================================
# LIVE TRADING CREDENTIALS
# ============================================
ALPACA_LIVE_API_KEY=your_live_api_key_here
ALPACA_LIVE_SECRET_KEY=your_live_secret_key_here
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# ============================================
# DATA API (Same for both paper and live)
# ============================================
ALPACA_DATA_URL=https://data.alpaca.markets

# ============================================
# AUTHENTICATION (Authentication)
# ============================================
UI_PASSWORD=your_secure_value_here
# JWT secret key for token signing (generate a random string for production)
# Example: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-random-string

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=sqlite:///./alpaca_orders.db

# ============================================
# SERVER CONFIGURATION
# ============================================
HOST=0.0.0.0
PORT=8000

# ============================================
# LOGGING & DEBUG
# ============================================
LOG_LEVEL=INFO
DEBUG=false

# ============================================
# FRONTEND CONFIGURATION
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================
# OPTIONAL: NOTIFICATIONS
# ============================================
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_credential_here
EMAIL_TO=
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# ============================================
# OPTIONAL: CLOUDFLARE DEPLOYMENT
# ============================================
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
# Development: http://localhost:3000,http://127.0.0.1:3000
# Production: Add https://your-domain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
