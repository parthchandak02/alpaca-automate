# ============================================
# Alpaca Trading Bot - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# USER CONFIGURATION (Change These)
# ============================================

# --- Alpaca API Keys (REQUIRED) ---
# Get your API keys from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# --- Trading Mode (REQUIRED) ---
# Set to true for paper trading (recommended for testing)
# Set to false for live trading (real money)
ALPACA_PAPER=true

# --- Authentication Password (REQUIRED) ---
# Plain text password for accessing the web UI
# Alternative: Use APP_PASSWORD_HASH with bcrypt (more secure)
UI_PASSWORD=your_password_here

# --- Email Notifications (OPTIONAL) ---
# Set to true to enable email notifications for order status changes
EMAIL_NOTIFICATIONS_ENABLED=false

# SMTP Configuration (for Gmail, use App Password - see README)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD="your-16-character-app-password"

# Email Recipients (comma-separated for multiple recipients)
EMAIL_TO=recipient@example.com

# --- Discord Notifications (OPTIONAL) ---
# Get webhook URL from Discord channel settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=

# --- CSV Files (OPTIONAL) ---
# Set to true to use test CSV files (fewer symbols, less API calls)
# Set to false to use production CSV files
USE_TEST_CSV=true

# ============================================
# ADVANCED CONFIGURATION (Usually Don't Change)
# ============================================

# --- Server Ports ---
PORT_API=8080
PORT_UI=3000
NEXT_PUBLIC_API_PORT=8080

# Next.js Public API Host (for frontend to connect to backend)
# For local development: leave empty or use "localhost"
# For Cloudflare Pages deployment: set to your backend domain (e.g., "api-your-domain.com")
# This must be prefixed with NEXT_PUBLIC_ to be accessible in the browser
NEXT_PUBLIC_API_HOST=

# --- Polling Settings ---
# Polling interval in seconds (fallback mode when WebSocket unavailable)
POLL_INTERVAL_SECONDS=60

# --- Alpaca API URLs (OPTIONAL - Auto-set based on ALPACA_PAPER) ---
# These are automatically set based on ALPACA_PAPER, but you can override them
ALPACA_PAPER_API_URL=https://paper-api.alpaca.markets/v2
ALPACA_LIVE_API_URL=https://api.alpaca.markets
ALPACA_DATA_API_URL=https://data.alpaca.markets/v2
ALPACA_TRADING_API_URL=

# --- Authentication (Advanced) ---
# Bcrypt password hash (alternative to UI_PASSWORD - more secure)
# Generate with: python scripts/setup_auth.py
APP_PASSWORD_HASH=

# JWT Secret Key (for token generation)
# Generate with: python scripts/setup_auth.py
JWT_SECRET_KEY=

# --- Cloudflare Deployment (For Production) ---
# API token for Cloudflare Pages/Wrangler CLI
# Get token from: https://dash.cloudflare.com/profile/api-tokens
# Use "Edit Cloudflare Workers" template or create custom token with:
#   - Account → Cloudflare Pages → Edit
#   - User → User Details → Read
CLOUDFLARE_API_TOKEN=

# Cloudflare Account ID (optional, can be found in dashboard URL)
# Format: 32-character hex string (e.g., 0e94c4d1c494e783d4d386498de3652d)
CLOUDFLARE_ACCOUNT_ID=
