# Alpaca API Keys
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_PAPER=true

# Discord Webhook URL (optional)
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Server Ports (configurable for different users/environments)
# API Server Port (Flask backend)
PORT_API=8080

# UI Server Port (Next.js frontend)
PORT_UI=3000

# Next.js Public API Port (for frontend to connect to backend)
# This must be prefixed with NEXT_PUBLIC_ to be accessible in the browser
# Must match PORT_API
NEXT_PUBLIC_API_PORT=8080
